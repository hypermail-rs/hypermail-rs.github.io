#!/bin/sh
#
# Pre-commit hook that runs cargo fmt and cargo clippy
# Install with: make install-hooks

set -e

echo "Running pre-commit checks..."

# Check if cargo is available
if ! command -v cargo >/dev/null 2>&1; then
    echo "Error: cargo not found. Please install Rust."
    exit 1
fi

# Run cargo fmt check (don't modify files, just check)
echo "Checking code formatting..."
if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "❌ Code formatting issues found. Running cargo fmt..."
    cargo fmt --all
    echo "✅ Code formatted. Please review changes and commit again."
    exit 1
fi

# Run cargo clippy
echo "Running clippy lints..."
if ! cargo clippy --all-targets --all-features -- -D warnings 2>&1 | grep -q "Finished"; then
    echo "❌ Clippy found issues. Please fix them before committing."
    cargo clippy --all-targets --all-features -- -D warnings
    exit 1
fi

echo "✅ Pre-commit checks passed"
exit 0
